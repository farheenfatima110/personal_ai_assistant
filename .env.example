# Copy to .env and fill in your own key. Never commit the real .env.
# Any LiteLLM-supported provider works.

# --- Example: OpenRouter ---
OPENAI_MODEL_NAME=gpt-oss-120b
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-your-key-here

# --- Example: OpenAI directly ---
# OPENAI_MODEL_NAME=gpt-4o-mini
# OPENAI_API_KEY=sk-your-openai-key

# Embeddings are 100% local (model2vec) - no embedding key needed.
